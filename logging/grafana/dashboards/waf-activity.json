{
  "uid": "waf-activity",
  "title": "WAF Activity",
  "tags": [
    "proxywarden"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Flagged events (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"waf-audit\", rule_id!=\"\"}[24h]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Distinct rules (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(count_over_time({job=\"waf-audit\", rule_id!=\"\"}[24h]) by (rule_id))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "title": "Distinct source IPs (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(count_over_time({job=\"waf-audit\", client_ip!=\"\"}[24h]) by (client_ip))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "title": "Blocked (rule_id + 4xx/5xx, 24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"waf-audit\", rule_id!=\"\"} | json | transaction_response_http_code >= 400 [24h]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "title": "Events by rule (top 10)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (rule_id) (count_over_time({job=\"waf-audit\", rule_id!=\"\"}[$__auto])))",
          "legendFormat": "{{rule_id}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "title": "Events by source IP (top 10)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (client_ip) (count_over_time({job=\"waf-audit\", client_ip!=\"\"}[$__auto])))",
          "legendFormat": "{{client_ip}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 7,
      "title": "Recent events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true,
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"waf-audit\", rule_id!=\"\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
# proxywarden deploy environment — copy to .env next to docker-compose.yml
#   cp env.example .env
#
# Pin the exact image tag: the tag carries the whole pin set
# (npm, openresty, modsec, CRS, vts, purge, frontend) — never ship a floating
# :latest in prod. An update = edit this one line, then:
#   docker compose pull && docker compose up -d
PROXYWARDEN_IMAGE=ghcr.io/funkysys-org/proxywarden:2.17.0-or1.31.8.1-modsec3.0.17-crs4.30.0-vts0.2.7-purge3.0.4-fe2.17.0

# The registry is private: before the first pull
#   docker login ghcr.io -u <github-user>     # PAT with read:packages

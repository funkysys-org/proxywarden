--- a/backend/internal/host.js
+++ b/backend/internal/host.js
@@ -355,6 +355,27 @@ const internalHost = {
 
 		return response;
 	},
+
+	/**
+	 * Country list coherence gate (wave 025): a whitelist
+	 * (country_list_mode=allow) with an empty list would 403 every visitor
+	 * on an armed host — fail closed at the API instead, before anything is
+	 * stored or rendered. On update, pass the MERGED state (existing row +
+	 * payload overrides) so a mode-only update against a host that already
+	 * carries a list is judged correctly.
+	 * @param   {Object}  mergedData
+	 * @returns {void}     throws ValidationError
+	 */
+	assertCountryListCoherent: (mergedData) => {
+		if (mergedData.country_list_mode === "allow") {
+			const list = mergedData.country_deny;
+			if (!Array.isArray(list) || list.length === 0) {
+				throw new errs.ValidationError(
+					"country_list_mode=allow requires a non-empty country_deny list — an empty allow-list would block every visitor",
+				);
+			}
+		}
+	},
 };
 
 export default internalHost;

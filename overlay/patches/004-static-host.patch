new file mode 100644
index 0000000..1f7a7f9
--- /dev/null
+++ b/backend/lib/access/static_hosts-create.json
@@ -0,0 +1,23 @@
+{
+	"anyOf": [
+		{
+			"$ref": "roles#/definitions/admin"
+		},
+		{
+			"type": "object",
+			"required": ["permission_static_hosts", "roles"],
+			"properties": {
+				"permission_static_hosts": {
+					"$ref": "perms#/definitions/manage"
+				},
+				"roles": {

diff --git a/backend/templates/static_host.conf b/backend/templates/static_host.conf
new file mode 100644
index 0000000..130ccdd
--- /dev/null
+++ b/backend/templates/static_host.conf
@@ -0,0 +1,29 @@
+{% include "_header_comment.conf" %}
+
+{% if enabled %}
+
+{% include "_hsts_map.conf" %}
+
+server {
+{% include "_listen.conf" %}
+{% include "_certificates.conf" %}
+{% include "_hsts.conf" %}
+{% include "_forced_ssl.conf" %}
+
+  access_log /data/logs/static-host-{{ id }}_access.log standard;
+  error_log /data/logs/static-host-{{ id }}_error.log warn;
+
+{{ advanced_config }}
+
+{% if use_default_location %}
+  location / {
+{% include "_hsts.conf" %}
+    root /data/nginx/static_host/{{ id }};
+    try_files /index.html =404;
+  }
+{% endif %}
+
+  # Custom
+  include /data/nginx/custom/server_static[.]conf;
+}
+{% endif %}

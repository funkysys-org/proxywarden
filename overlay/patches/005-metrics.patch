diff --git a/docker/rootfs/etc/nginx/conf.d/proxywarden-vts-zone.conf b/docker/rootfs/etc/nginx/conf.d/proxywarden-vts-zone.conf
new file mode 100644
index 0000000..6ab96e5
--- /dev/null
+++ b/docker/rootfs/etc/nginx/conf.d/proxywarden-vts-zone.conf
@@ -0,0 +1,6 @@
+# proxywarden metrics: enable the vts counters at http level.
+# Loaded-but-cheap: the zone directive just starts counting per-server
+# traffic. Nothing is exposed from here — the display lives on the admin
+# server and is 127.0.0.1-only (see production.conf.template); the backend
+# reads it and re-serves it JWT-scoped at GET /api/reports/metrics.
+vhost_traffic_status_zone;

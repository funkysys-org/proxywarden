diff --git a/backend/routes/waf.js b/backend/routes/waf.js
new file mode 100644
index 0000000..a80f45c
--- /dev/null
+++ b/backend/routes/waf.js
@@ -0,0 +1,55 @@
+import express from "express";
+import internalWaf from "../internal/waf.js";
+import jwtdecode from "../lib/express/jwt-decode.js";
+import apiValidator from "../lib/validator/api.js";
+import { debug, express as logger } from "../logger.js";
+import { getValidationSchema } from "../schema/index.js";
+
+const router = express.Router({
+	caseSensitive: true,
+	strict: true,
+	mergeParams: true,
+});
+
+/**
+ * /api/waf/tuning
+ */
+router
+	.route("/tuning")
+	.options((_, res) => {
+		res.sendStatus(204);
+	})
+	.all(jwtdecode())
+
+	/**
+	 * GET /api/waf/tuning
+	 *
+	 * Retrieve the current WAF tuning state (exclusions + paranoia level)
+	 */
+	.get(async (req, res, next) => {
+		try {
+			const data = await internalWaf.getTuning(res.locals.access);
+			res.status(200).send(data);
+		} catch (err) {
+			debug(logger, `${req.method.toUpperCase()} ${req.path}: ${err}`);
+			next(err);
+		}
+	})
+
+	/**
+	 * PUT /api/waf/tuning
+	 *
+	 * Replace the exclusions list and/or the paranoia level, then reload
+	 */
+	.put(async (req, res, next) => {
+		try {
+			const payload = await apiValidator(getValidationSchema("/waf/tuning", "put"), req.body);
+			const data = await internalWaf.updateTuning(res.locals.access, payload);
+			res.status(200).send(data);
+		} catch (err) {
+			debug(logger, `${req.method.toUpperCase()} ${req.path}: ${err}`);
+			next(err);
+		}
+	});
+
+export default router;
diff --git a/backend/schema/paths/waf/tuning/get.json b/backend/schema/paths/waf/tuning/get.json

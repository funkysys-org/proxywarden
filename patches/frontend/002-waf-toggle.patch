diff --git a/frontend/src/modals/ProxyHostModal.tsx b/frontend/src/modals/ProxyHostModal.tsx
index 38cdb75..3444a18 100644
--- a/frontend/src/modals/ProxyHostModal.tsx
+++ b/frontend/src/modals/ProxyHostModal.tsx
@@ -39,6 +39,17 @@ const ProxyHostModal = EasyModal.create(({ id, visible, remove }: Props) => {
 
 	const isAdmin = currentUser?.roles?.includes("admin");
 
+	// Proxywarden WAF state, derived from advancedConfig — recognizes both the
+	// marked block AND the bare two-line pattern (hand-configured hosts).
+	const wafBlock =
+		/modsecurity on;\s*modsecurity_rules_file\s+\/etc\/nginx\/modsec\/main-block\.conf;/.test(
+			data?.advancedConfig || "",
+		);
+	const wafDetect =
+		/modsecurity on;\s*modsecurity_rules_file\s+\/etc\/nginx\/modsec\/main\.conf;/.test(
+			data?.advancedConfig || "",
+		) && !wafBlock;
+
 	const onSubmit = async (values: any, { setSubmitting }: any) => {
 		if (isSubmitting) return;
 		setIsSubmitting(true);
@@ -50,6 +61,25 @@ const ProxyHostModal = EasyModal.create(({ id, visible, remove }: Props) => {
 		};
 		payload.locations = (values.locations || []).filter((location: any) => location.path?.trim() !== "");
 
+		// Proxywarden WAF switches are UI state, not API fields: strip them and
+		// compose the marked block inside advancedConfig (admin-only field).
+		delete payload.wafDetect;
+		delete payload.wafBlock;
+		if (isAdmin) {
+			// Strips BOTH the marked block and the bare hand-written directives
+			// (so flipping a switch can never produce duplicates).
+			const wafStripRe =
+				/\n?# BEGIN PROXYWARDEN WAF[\s\S]*?# END PROXYWARDEN WAF\n?|modsecurity on;\s*modsecurity_rules_file\s+\/etc\/nginx\/modsec\/main(-block)?\.conf;\n?/g;
+			let advancedConfig = (values.advancedConfig || "").replace(wafStripRe, "");
+			if (values.wafBlock || values.wafDetect) {
+				const rulesFile = values.wafBlock
+					? "/etc/nginx/modsec/main-block.conf"
+					: "/etc/nginx/modsec/main.conf";
+				advancedConfig = `${advancedConfig.trim()}\n\n# BEGIN PROXYWARDEN WAF\nmodsecurity on;\nmodsecurity_rules_file ${rulesFile};\n# END PROXYWARDEN WAF\n`.trim();
+			}
+			payload.advancedConfig = advancedConfig;
+		}
+
 		if (!isAdmin) {
 			delete payload.advanced_config;
 			delete payload.advancedConfig;
@@ -100,6 +130,9 @@ const ProxyHostModal = EasyModal.create(({ id, visible, remove }: Props) => {
 							cachingEnabled: data?.cachingEnabled || false,
 							blockExploits: data?.blockExploits || false,
 							allowWebsocketUpgrade: data?.allowWebsocketUpgrade || false,
+						// Proxywarden WAF (UI-only state; composed into advancedConfig on submit)
+						wafDetect,
+						wafBlock,
 							// Locations tab
 							locations: data?.locations || [],
 							// SSL tab
@@ -355,8 +388,66 @@ const ProxyHostModal = EasyModal.create(({ id, visible, remove }: Props) => {
 																	</Field>
 																</span>
 															</label>
-														</div>
-													</div>
+															</div>
+															{isAdmin && (
+															<>
+																<div>
+																	<label className="row" htmlFor="wafDetect">
+																		<span className="col">
+																			<T id="host.flags.waf-detect" />
+																		</span>
+																		<span className="col-auto">
+																			<Field name="wafDetect" type="checkbox">
+																				{({ field, form }: any) => (
+																					<label className="form-check form-check-single form-switch">
+																						<input
+																							id="wafDetect"
+																							className={cn("form-check-input", {
+																								"bg-lime": field.checked,
+																							})}
+																							type="checkbox"
+																							checked={field.checked}

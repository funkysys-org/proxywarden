--- /dev/null
+++ b/frontend/src/components/MetricsDashboard.tsx
@@ -0,0 +1,324 @@
+import { useEffect, useState } from "react";
+import {
+	Bar,
+	BarChart,
+	Cell,
+	Pie,
+	PieChart,
+	ResponsiveContainer,
+	Tooltip,
+	XAxis,
+	YAxis,
+} from "recharts";
+import { useMetricsReport, useWafReport } from "src/hooks";
+import { T } from "src/locale";
+
+const STATUS_COLORS: Record<string, string> = {
+	"2xx": "#4bb4d6",
+	"3xx": "#2fb344",
+	"4xx": "#f76707",
+	"5xx": "#d63939",
+};
+
+type Sample = {
+	t: number;
+	requests: number;
+	inBytes: number;
+	outBytes: number;
+};
+
+// The metrics dashboard body, hosted by the main Dashboard page since the
+// standalone /metrics page was retired. Admin-only (ADMIN permission),
+// wrapped by the Dashboard.
+export const MetricsDashboard = () => {
+	const { data: report, isFetching, dataUpdatedAt } = useMetricsReport();
+	const { data: waf } = useWafReport();
+	const [samples, setSamples] = useState<Sample[]>([]);
+
+	const zones = report?.serverZones || {};
+	const zoneNames = Object.keys(zones).filter((z) => z !== "*" && !z.startsWith("$"));
+
+	const totals = zoneNames.reduce(
+		(acc, name) => {
+			const z = zones[name];
+			acc.requests += z.requestCounter || 0;
+			acc.inBytes += z.inBytes || 0;
+			acc.outBytes += z.outBytes || 0;
+			return acc;
+		},
+		{ requests: 0, inBytes: 0, outBytes: 0 },
+	);
+
+	// Session sampling: vts counters are cumulative since boot; each poll
+	// appends a sample so the series shows live deltas.
+	useEffect(() => {
+		if (!dataUpdatedAt || !report) {
+			return;
+		}
+		const sample: Sample = {
+			t: dataUpdatedAt,
+			requests: totals.requests,
+			inBytes: totals.inBytes,
+			outBytes: totals.outBytes,
+		};
+		setSamples((prev) => {
+			const next = [...prev, sample];
+			return next.length > 120 ? next.slice(next.length - 120) : next;
+		});
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, [dataUpdatedAt]);
+
+	const rateSeries = samples.slice(1).map((s, i) => {
+		const prev = samples[i];
+		const dt = (s.t - prev.t) / 1000;
+		return {
+			time: new Date(s.t).toLocaleTimeString(),
+			reqPerSec: dt > 0 ? Math.round(((s.requests - prev.requests) / dt) * 10) / 10 : 0,
+		};
+	});
+
+	const statusData = ["2xx", "3xx", "4xx", "5xx"]
+		.map((code) => ({
+			name: code,
+			value: zoneNames.reduce((sum, name) => sum + (zones[name]?.responses?.[code as "2xx"] || 0), 0),
+		}))
+		.filter((d) => d.value > 0);
+
+	const hostRows = zoneNames
+		.map((name) => {
+			const z = zones[name];
+			return {
+				name,
+				requests: z.requestCounter || 0,
+				inBytes: z.inBytes || 0,
+				outBytes: z.outBytes || 0,
+				"2xx": z.responses?.["2xx"] || 0,
+			"3xx": z.responses?.["3xx"] || 0,
+			"4xx": z.responses?.["4xx"] || 0,
+				"5xx": z.responses?.["5xx"] || 0,
+			};
+		})
+		.sort((a, b) => b.requests - a.requests);
+
+	const fmtBytes = (n: number) => {
+		if (n > 1024 * 1024 * 1024) return `${(n / 1024 / 1024 / 1024).toFixed(1)} GB`;
+		if (n > 1024 * 1024) return `${(n / 1024 / 1024).toFixed(1)} MB`;
+		if (n > 1024) return `${(n / 1024).toFixed(1)} KB`;
+		return `${n} B`;
+	};
+
+	return (
+		<div>
+			<div className="row row-deck row-cards">
+				<div className="col-sm-6 col-lg-3">
+					<div className="card card-sm">
+						<div className="card-body">
+							<div className="text-muted">
+								<T id="metrics.total-requests" />
+							</div>
+							<div className="h2">{totals.requests.toLocaleString()}</div>
+						</div>
+					</div>
+				</div>
+				<div className="col-sm-6 col-lg-3">
+					<div className="card card-sm">
+						<div className="card-body">
+							<div className="text-muted">
+								<T id="metrics.bandwidth-out" />
+							</div>
+							<div className="h2">{fmtBytes(totals.outBytes)}</div>
+						</div>
+					</div>
+				</div>
+				<div className="col-sm-6 col-lg-3">
+					<div className="card card-sm">
+						<div className="card-body">
+							<div className="text-muted">
+								<T id="metrics.zones" />
+							</div>
+							<div className="h2">{zoneNames.length}</div>
+						</div>
+					</div>
+				</div>
+				<div className="col-sm-6 col-lg-3">
+					<div className="card card-sm">
+						<div className="card-body">
+							<div className="text-muted">
+								<T id="metrics.visibility" />
+							</div>
+							<div className="h2">{report?.visibility === "all" ? "all" : "user"}</div>
+						</div>
+					</div>
+				</div>
+			</div>
+
+			<div className="row row-deck row-cards">
+				<div className="col-lg-8">
+					<div className="card">
+						<div className="card-header">
+							<h3 className="card-title">
+								<T id="metrics.requests-sec" /> {isFetching ? "…" : ""}
+							</h3>
+							<div className="card-subtitle text-secondary">
+								<T id="metrics.window-30m" />
+							</div>
+						</div>
+						<div className="card-body" style={{ height: 260 }}>
+							<ResponsiveContainer width="100%" height="100%">
+								<BarChart data={rateSeries}>
+									<XAxis dataKey="time" tick={{ fontSize: 10 }} />
+									<YAxis tick={{ fontSize: 10 }} allowDecimals={false} />
+									<Tooltip />
+									<Bar dataKey="reqPerSec" fill="#14b8a6" />
+								</BarChart>
+							</ResponsiveContainer>
+						</div>
+					</div>
+				</div>
+				<div className="col-lg-4">
+					<div className="card">
+						<div className="card-header">
+							<h3 className="card-title">
+								<T id="metrics.status-codes" />
+							</h3>
+							<div className="card-subtitle text-secondary">
+								<T id="metrics.since-boot" />
+							</div>
+						</div>
+						<div className="card-body" style={{ height: 260 }}>
+							<ResponsiveContainer width="100%" height="100%">
+								<PieChart>
+									<Pie data={statusData} dataKey="value" nameKey="name" innerRadius={55} outerRadius={85}>
+										{statusData.map((entry) => (
+											<Cell key={entry.name} fill={STATUS_COLORS[entry.name] || "#999"} />
+										))}
+									</Pie>
+									<Tooltip />
+								</PieChart>
+							</ResponsiveContainer>
+						</div>
+					</div>
+				</div>
+			</div>
+
+			<div className="card mt-4">
+				<div className="card-header">
+					<h3 className="card-title">
+						<T id="metrics.hosts" />
+					</h3>
+					<div className="card-subtitle text-secondary">
+						<T id="metrics.since-boot" />
+					</div>
+				</div>
+				<div className="table-responsive">
+					<table className="table table-vcenter card-table">
+						<thead>
+							<tr>
+								<th>
+									<T id="column.source" />
+								</th>
+								<th className="text-end">
+									<T id="metrics.total-requests" />
+								</th>
+								<th className="text-end">
+									<T id="metrics.2xx" />
+								</th>
+								<th className="text-end">
+									<T id="metrics.3xx" />
+								</th>
+								<th className="text-end">
+									<T id="metrics.4xx" />
+								</th>
+								<th className="text-end">
+									<T id="metrics.5xx" />
+								</th>
+								<th className="text-end">
+									<T id="metrics.bandwidth-out" />
+								</th>
+							</tr>
+						</thead>
+						<tbody>
+							{hostRows.map((row) => (
+								<tr key={row.name}>
+									<td>{row.name}</td>
+									<td className="text-end">{row.requests.toLocaleString()}</td>
+									<td className="text-end text-success">{row["2xx"] || 0}</td>
+									<td className="text-end text-secondary">{row["3xx"] || 0}</td>
+									<td className="text-end text-warning">{row["4xx"] || 0}</td>
+									<td className="text-end text-danger">{row["5xx"] || 0}</td>
+									<td className="text-end">{fmtBytes(row.outBytes)}</td>
+								</tr>
+							))}
+							{!hostRows.length && (
+								<tr>
+									<td colSpan={5} className="text-muted">
+										<T id="metrics.no-data" />
+									</td>
+								</tr>
+							)}
+						</tbody>
+					</table>
+				</div>
+			</div>
+
+			<div className="card mt-4">
+				<div className="card-status-top bg-teal" />
+			<div className="card-header">
+				<h3 className="card-title">
+					<T id="metrics.waf" />
+				</h3>
+				<div className="card-subtitle text-secondary">
+					<T id="metrics.waf-hint" />
+				</div>
+			</div>
+			<div className="card-body">
+				<div className="row mb-3">
+					<div className="col-6 col-lg-3">
+						<div className="h1 m-0">{(waf?.flagged ?? 0).toLocaleString()}</div>
+						<div className="text-secondary">
+							<T id="metrics.waf-flagged" />
+						</div>
+					</div>
+					<div className="col-6 col-lg-3">
+						<div className="h1 m-0 text-danger">{(waf?.blocked ?? 0).toLocaleString()}</div>
+						<div className="text-secondary">
+							<T id="metrics.waf-blocked" />
+						</div>
+					</div>
+				</div>
+				<div className="table-responsive">
+					<table className="table table-vcenter card-table">
+						<thead>
+							<tr>
+								<th>
+									<T id="metrics.waf-rule" />
+								</th>
+								<th className="text-end">
+									<T id="metrics.waf-hits" />
+								</th>
+							</tr>
+						</thead>
+						<tbody>
+							{(waf?.perRule ?? []).map((r) => (
+								<tr key={r.id}>
+									<td>
+										<code className="font-monospace">{r.id}</code>
+									</td>
+									<td className="text-end">{r.count.toLocaleString()}</td>
+								</tr>
+							))}
+							{!(waf?.perRule ?? []).length && (
+								<tr>
+									<td colSpan={2} className="text-muted">
+										<T id="metrics.no-data" />
+									</td>
+								</tr>
+							)}
+						</tbody>
+					</table>
+				</div>
+			</div>
+		</div>
+		</div>
+	);
+};

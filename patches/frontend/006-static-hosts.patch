diff --git a/frontend/src/modals/StaticHostModal.tsx b/frontend/src/modals/StaticHostModal.tsx
new file mode 100644
index 0000000..3f2ed77
--- /dev/null
+++ b/frontend/src/modals/StaticHostModal.tsx
@@ -0,0 +1,298 @@
+import { IconSettings } from "@tabler/icons-react";
+import cn from "classnames";
+import EasyModal, { type InnerModalProps } from "ez-modal-react";
+import { Field, Form } from "formik";
+import { type ReactNode, useState } from "react";
+import { Alert } from "react-bootstrap";
+import Modal from "react-bootstrap/Modal";
+import {
+	Button,
+	DomainNamesField,
+	Loading,
+	NginxConfigField,
+	SSLCertificateField,
+	SSLOptionsFields,
+} from "src/components";
+import { FormModal } from "src/components/Form";
+import { useStaticHost, useSetStaticHost, useUser } from "src/hooks";
+import { T } from "src/locale";
+import { showObjectSuccess } from "src/notifications";
+
+const showStaticHostModal = (id: number | "new") => {
+	EasyModal.show(StaticHostModal, { id });
+};
+
+interface Props extends InnerModalProps {
+	id: number | "new";
+}
+const StaticHostModal = EasyModal.create(({ id, visible, remove }: Props) => {
+	const { data: currentUser, isLoading: userIsLoading, error: userError } = useUser("me");
+	const { data, isLoading, error } = useStaticHost(id);
+	const { mutate: setStaticHost } = useSetStaticHost();
+	const [errorMsg, setErrorMsg] = useState<ReactNode | null>(null);
+	const [isSubmitting, setIsSubmitting] = useState(false);
+
+	const isAdmin = currentUser?.roles?.includes("admin");
+
+	// Proxywarden WAF state, derived from advancedConfig — recognizes both the
+	// marked block AND the bare two-line pattern (hand-configured hosts).
+	const wafBlock =
+		/modsecurity on;\s*modsecurity_rules_file\s+\/etc\/nginx\/modsec\/main-block\.conf;/.test(
+			data?.advancedConfig || "",
+		);
+	const wafDetect =
+		/modsecurity on;\s*modsecurity_rules_file\s+\/etc\/nginx\/modsec\/main\.conf;/.test(
+			data?.advancedConfig || "",
+		) && !wafBlock;
+
+	const onSubmit = async (values: any, { setSubmitting }: any) => {
+		if (isSubmitting) return;
+		setIsSubmitting(true);
+		setErrorMsg(null);
+
+		const { ...payload } = {
+			id: id === "new" ? undefined : id,
+			...values,
+		};
+
+		// Proxywarden WAF switches are UI state, not API fields: strip them and
+		// compose the marked block inside advancedConfig (admin-only field).
+		delete payload.wafDetect;
+		delete payload.wafBlock;
+		if (!isAdmin) {
+			delete payload.advanced_config;
+			delete payload.advancedConfig;
+		} else {
+			// Strips BOTH the marked block and the bare hand-written directives
+			// (so flipping a switch can never produce duplicates).
+			const wafStripRe =
+				/\n?# BEGIN PROXYWARDEN WAF[\s\S]*?# END PROXYWARDEN WAF\n?|modsecurity on;\s*modsecurity_rules_file\s+\/etc\/nginx\/modsec\/main(-block)?\.conf;\n?/g;
+			let advancedConfig = (values.advancedConfig || "").replace(wafStripRe, "");
+			if (values.wafBlock || values.wafDetect) {
+				const rulesFile = values.wafBlock
+					? "/etc/nginx/modsec/main-block.conf"
+					: "/etc/nginx/modsec/main.conf";
+				advancedConfig = `${advancedConfig.trim()}\n\n# BEGIN PROXYWARDEN WAF\nmodsecurity on;\nmodsecurity_rules_file ${rulesFile};\n# END PROXYWARDEN WAF\n`.trim();
+			}
+			payload.advancedConfig = advancedConfig;
+		}
+
+		setStaticHost(payload, {
+			onError: (err: any) => setErrorMsg(<T id={err.message} />),
+			onSuccess: () => {
+				showObjectSuccess("static-host", "saved");
+				remove();
+			},
+			onSettled: () => {
+				setIsSubmitting(false);
+				setSubmitting(false);
+			},
+		});
+	};
+
+	return (
+		<>
+			{(isLoading || userIsLoading || ((error || userError) && (!data || !currentUser))) && (
+				<Modal show={visible} onHide={remove}>
+					{!isLoading && (error || userError) && (
+						<Alert variant="danger" className="m-3">
+							{error?.message || userError?.message || "Unknown error"}
+						</Alert>
+					)}
+					{(isLoading || userIsLoading) && <Loading noLogo />}
+				</Modal>
+			)}
+			{!isLoading && !userIsLoading && data && currentUser && (
+				<FormModal
+					show={visible}
+					onHide={remove}
+					preventHide={isSubmitting}
+					initialValues={
+						{
+							domainNames: data?.domainNames,
+							certificateId: data?.certificateId,
+							sslForced: data?.sslForced,
+							advancedConfig: data?.advancedConfig,
+							http2Support: data?.http2Support,
+							hstsEnabled: data?.hstsEnabled,
+							hstsSubdomains: data?.hstsSubdomains,
+							meta: data?.meta || {},
+							content: data?.content || "",
+							wafDetect,
+							wafBlock,
+						} as any
+					}
+					onSubmit={onSubmit}
+				>
+					{({ onHide }) => (
+						<Form>
+							<Modal.Header closeButton>
+								<Modal.Title>
+									<T id={data?.id ? "object.edit" : "object.add"} tData={{ object: "static-host" }} />
+								</Modal.Title>
+							</Modal.Header>
+							<Modal.Body className="p-0">
+								<Alert variant="danger" show={!!errorMsg} onClose={() => setErrorMsg(null)} dismissible>
+									{errorMsg}
+								</Alert>
+								<div className="card m-0 border-0">
+									<div className="card-header">
+										<ul className="nav nav-tabs card-header-tabs" data-bs-toggle="tabs">
+											<li className="nav-item" role="presentation">
+												<a
+													href="#tab-details"
+													className="nav-link active"
+													data-bs-toggle="tab"
+													aria-selected="true"
+													role="tab"
+												>
+													<T id="column.details" />
+												</a>
+											</li>
+											<li className="nav-item" role="presentation">
+												<a
+													href="#tab-ssl"
+													className="nav-link"
+													data-bs-toggle="tab"
+													aria-selected="false"
+													tabIndex={-1}
+													role="tab"
+												>
+													<T id="column.ssl" />
+												</a>
+											</li>
+											{isAdmin && (
+												<li className="nav-item ms-auto" role="presentation">
+													<a
+														href="#tab-advanced"
+														className="nav-link"
+														title="Settings"
+														data-bs-toggle="tab"
+														aria-selected="false"
+														tabIndex={-1}
+														role="tab"
+													>
+														<IconSettings size={20} />
+													</a>
+												</li>
+											)}
+										</ul>
+									</div>
+									<div className="card-body">
+										<div className="tab-content">
+											<div className="tab-pane active show" id="tab-details" role="tabpanel">
+												<DomainNamesField isWildcardPermitted dnsProviderWildcardSupported />
+												<div className="mb-3">
+													<label className="form-label" htmlFor="content">
+														<T id="static-host" />
+													</label>
+													<Field name="content">
+														{({ field }: any) => (
+															<textarea
+																id="content"
+																className="form-control font-monospace"
+																rows={10}
+																spellCheck={false}
+																{...field}
+															/>
+														)}
+													</Field>
+												</div>
+											</div>
+											<div className="tab-pane" id="tab-ssl" role="tabpanel">
+												<SSLCertificateField
+													name="certificateId"
+													label="ssl-certificate"
+													allowNew
+												/>
+												<SSLOptionsFields color="bg-red" />
+											</div>
+											{isAdmin && (
+												<div className="tab-pane" id="tab-advanced" role="tabpanel">
+													<div className="mb-3">
+														<div>
+															<label className="row" htmlFor="wafDetect">
+																<span className="col">
+																	<T id="host.flags.waf-detect" />
+																</span>
+																<span className="col-auto">
+																	<Field name="wafDetect" type="checkbox">
+																		{({ field, form }: any) => (
+																			<label className="form-check form-check-single form-switch">
+																				<input
+																					id="wafDetect"
+																					className={cn("form-check-input", {
+																						"bg-lime": field.checked,
+																					})}
+																					type="checkbox"
+																					checked={field.checked}
+																					onChange={(e) => {
+																						form.setFieldValue("wafDetect", e.target.checked);
+																						if (e.target.checked) form.setFieldValue("wafBlock", false);
+																					}}
+																				/>
+																			</label>
+																		)}
+																	</Field>
+																</span>
+															</label>
+														</div>
+														<div>
+															<label className="row" htmlFor="wafBlock">
+																<span className="col">
+																	<T id="host.flags.waf-block" />
+																</span>
+																<span className="col-auto">
+																	<Field name="wafBlock" type="checkbox">
+																		{({ field, form }: any) => (
+																			<label className="form-check form-check-single form-switch">
+																				<input
+																					id="wafBlock"
+																					className={cn("form-check-input", {
+																						"bg-lime": field.checked,
+																					})}
+																					type="checkbox"
+																					checked={field.checked}
+																					onChange={(e) => {
+																						form.setFieldValue("wafBlock", e.target.checked);
+																						if (e.target.checked) form.setFieldValue("wafDetect", false);
+																					}}
+																				/>
+																			</label>
+																		)}
+																	</Field>
+																</span>
+															</label>
+														</div>
+													</div>
+													<NginxConfigField />
+												</div>
+											)}
+										</div>
+									</div>
+								</div>
+							</Modal.Body>
+							<Modal.Footer>
+								<Button data-bs-dismiss="modal" onClick={onHide} disabled={isSubmitting}>
+									<T id="cancel" />
+								</Button>
+								<Button
+									type="submit"
+									actionType="primary"
+									className="ms-auto bg-red"
+									data-bs-dismiss="modal"
+									isLoading={isSubmitting}
+									disabled={isSubmitting}
+								>
+									<T id="save" />
+								</Button>
+							</Modal.Footer>
+						</Form>
+					)}
+				</FormModal>
+			)}
+		</>
+	);
+});
+
+export { showStaticHostModal };

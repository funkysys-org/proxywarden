diff --git a/frontend/src/hooks/useWafReport.ts b/frontend/src/hooks/useWafReport.ts
new file mode 100644
index 0000000..e2576f9
--- /dev/null
+++ b/frontend/src/hooks/useWafReport.ts
@@ -0,0 +1,13 @@
+import { useQuery } from "@tanstack/react-query";
+import { getWafReport, type WafReport } from "src/api/backend";
+
+const useWafReport = (options = {}) => {
+	return useQuery<WafReport, Error>({
+		queryKey: ["waf-report"],
+		queryFn: () => getWafReport(),
+		staleTime: 15 * 1000, // 15 seconds
+		...options,
+	});
+};
+
+export { useWafReport };
